#!/usr/bin/env python3
"""Generate images with OpenAI via the Responses API.

Supports multiple reference images with positional labels so you can say
"subject of Image 1, style of Image 2" in your prompt.

Transparent backgrounds:
  --transparent uses green-screen chroma key: generates with a solid #00FF00
  background, then strips it to alpha with PIL. Preserves all foreground
  objects (laptops, books, etc.) unlike AI-based removal.

Requires OPENAI_API_KEY in the environment. Deps: openai, Pillow, rembg.
"""

from __future__ import annotations

import argparse
import base64
import os
import re
import shutil
import sys
from collections import deque
from pathlib import Path

DEFAULT_MODEL = "gpt-4o"
DEFAULT_SIZE = "1792x1024"
DEFAULT_QUALITY = "medium"

THUMBNAIL_WIDTH = 1280


# ── file utilities ──────────────────────────────────────────────────────────

def _suffix_from_path(path: Path) -> str:
    ext = path.suffix.lower()
    if ext in (".jpg", ".jpeg"):
        return "jpeg"
    if ext == ".png":
        return "png"
    if ext == ".webp":
        return "webp"
    if ext == ".gif":
        return "gif"
    return "png"


def _next_image_index(out_dir: Path) -> int:
    existing = []
    if out_dir.exists():
        for p in out_dir.iterdir():
            m = re.match(r"image-(\d+)\.", p.name)
            if m:
                existing.append(int(m.group(1)))
    return max(existing, default=0) + 1


def _resize_proportional(path: Path, max_width: int = THUMBNAIL_WIDTH) -> None:
    """Resize image to fit within max_width, preserving aspect ratio."""
    from PIL import Image

    with Image.open(path) as img:
        w, h = img.size
        if w <= max_width:
            return
        ratio = max_width / w
        new_size = (max_width, int(h * ratio))
        resized = img.resize(new_size, Image.LANCZOS)
        resized.save(path)


def _detect_extension(raw: bytes) -> str:
    if raw[:4] == b"\x89PNG":
        return ".png"
    if raw[:2] == b"\xff\xd8":
        return ".jpg"
    if raw[:4] == b"RIFF":
        return ".webp"
    return ".png"


def _save_image(base64_data: str, out_dir: Path, index: int, suffix: str = "") -> Path:
    """Decode a base64 image and save it, returning the path."""
    raw = base64.b64decode(base64_data)
    ext = _detect_extension(raw)
    path = out_dir / f"image-{index:02d}{suffix}{ext}"
    path.write_bytes(raw)
    return path


def _prompt_slug(prompt: str, max_len: int = 45) -> str:
    words = re.sub(r"[^\w\s]", "", prompt.lower()).split()
    slug = "-".join(words[:6])
    return slug[:max_len] or "generated"


# ── image generation ────────────────────────────────────────────────────────

def _extract_images(response) -> list[str]:
    """Extract base64 image data from an OpenAI Responses API response."""
    images = []
    for output in response.output:
        if getattr(output, "type", None) == "image_generation_call":
            result = getattr(output, "result", None)
            if result:
                images.append(result)
    return images


GREEN_SCREEN_COLOR = (0, 255, 0)  # #00FF00
HARD_CUTOFF = 84   # Pixels within this distance become fully transparent
FEATHER_END = 132  # Soft edge between hard cutoff and this distance
EDGE_SCAN_STEP = 2


def _green_distance(r: int, g: int, b: int) -> float:
    r_key, g_key, b_key = GREEN_SCREEN_COLOR
    return ((r - r_key) ** 2 + (g - g_key) ** 2 + (b - b_key) ** 2) ** 0.5


def _is_background_candidate(r: int, g: int, b: int) -> bool:
    dist = _green_distance(r, g, b)
    green_dominant = g > r + 16 and g > b + 16
    bright_green = g > 150
    return dist < FEATHER_END and green_dominant and bright_green


def _chroma_key_green(path: Path) -> None:
    """Replace green-screen background with transparency.

    Pipeline:
    1. Remove outside-connected greenscreen via border flood-fill.
    2. Remove enclosed bright-green islands left in crevices.
    3. Despill semi-transparent edge pixels.
    """
    from PIL import Image

    img = Image.open(path).convert("RGBA")
    pixels = img.load()
    width, height = img.size

    visited: set[tuple[int, int]] = set()
    q: deque[tuple[int, int]] = deque()

    def maybe_enqueue(x: int, y: int) -> None:
        if 0 <= x < width and 0 <= y < height and (x, y) not in visited:
            r, g, b, _ = pixels[x, y]
            if _is_background_candidate(r, g, b):
                visited.add((x, y))
                q.append((x, y))

    # Seed from all image borders so only outside-connected green is removed.
    for x in range(0, width, EDGE_SCAN_STEP):
        maybe_enqueue(x, 0)
        maybe_enqueue(x, height - 1)
    for y in range(0, height, EDGE_SCAN_STEP):
        maybe_enqueue(0, y)
        maybe_enqueue(width - 1, y)

    while q:
        x, y = q.popleft()
        for nx, ny in (
            (x - 1, y), (x + 1, y), (x, y - 1), (x, y + 1),
            (x - 1, y - 1), (x + 1, y - 1), (x - 1, y + 1), (x + 1, y + 1),
        ):
            maybe_enqueue(nx, ny)

    # Remove visited background pixels, with feathering near the edge.
    for x, y in visited:
        r, g, b, a = pixels[x, y]
        dist = _green_distance(r, g, b)
        if dist < HARD_CUTOFF:
            pixels[x, y] = (r, g, b, 0)
        else:
            alpha = int(((dist - HARD_CUTOFF) / (FEATHER_END - HARD_CUTOFF)) * 255)
            alpha = max(0, min(255, alpha))
            pixels[x, y] = (r, g, b, min(a, alpha))

    # Second pass: remove enclosed bright-green islands anywhere in the image.
    island_seen: set[tuple[int, int]] = set()

    def is_green_island_pixel(r: int, g: int, b: int, a: int) -> bool:
        return a > 0 and g > 150 and g > r + 22 and g > b + 22

    for y in range(height):
        for x in range(width):
            if (x, y) in island_seen:
                continue
            r, g, b, a = pixels[x, y]
            if not is_green_island_pixel(r, g, b, a):
                continue
            island_q: deque[tuple[int, int]] = deque([(x, y)])
            island_seen.add((x, y))
            component: list[tuple[int, int]] = []
            while island_q:
                cx, cy = island_q.popleft()
                component.append((cx, cy))
                for nx, ny in (
                    (cx - 1, cy), (cx + 1, cy), (cx, cy - 1), (cx, cy + 1),
                    (cx - 1, cy - 1), (cx + 1, cy - 1), (cx - 1, cy + 1), (cx + 1, cy + 1),
                ):
                    if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in island_seen:
                        rr, gg, bb, aa = pixels[nx, ny]
                        if is_green_island_pixel(rr, gg, bb, aa):
                            island_seen.add((nx, ny))
                            island_q.append((nx, ny))
            for cx, cy in component:
                pixels[cx, cy] = (0, 0, 0, 0)

    # Final despill: neutralize green tint on partially transparent edge pixels.
    for y in range(height):
        for x in range(width):
            r, g, b, a = pixels[x, y]
            if 0 < a < 255 and g > r + 12 and g > b + 12:
                g2 = int((r + b) / 2)
                pixels[x, y] = (r, g2, b, a)
            elif a == 0:
                pixels[x, y] = (0, 0, 0, 0)

    png_path = path.with_suffix(".png")
    img.save(png_path, "PNG")
    if png_path != path:
        path.unlink()
        png_path.rename(path)


def run_generate(
    client,
    model: str,
    prompt: str,
    out_dir: Path,
    num_images: int,
    reference_image_paths: list[Path],
    mode: str,
) -> list[Path]:
    """Generate via Responses API.

    Modes:
    - plain: generate image-01.png
    - greenscreen: generate image-01-greenscreen.png
    - transparent: generate image-01-greenscreen.png + image-01-transparent.png
    """
    content: list[dict] = []

    for i, ref_path in enumerate(reference_image_paths):
        suffix = _suffix_from_path(ref_path)
        b64 = base64.b64encode(ref_path.read_bytes()).decode()
        content.append({
            "type": "input_text",
            "text": f"Reference Image {i + 1}:",
        })
        content.append({
            "type": "input_image",
            "image_url": f"data:image/{suffix};base64,{b64}",
        })

    content.append({"type": "input_text", "text": prompt})

    saved_paths: list[Path] = []
    next_idx = _next_image_index(out_dir)

    for n in range(num_images):
        response = client.responses.create(
            model=model,
            input=[{"role": "user", "content": content}],
            tools=[{"type": "image_generation"}],
        )

        image_b64_list = _extract_images(response)
        if not image_b64_list:
            raise RuntimeError(f"Call {n + 1}/{num_images}: no images in response.")

        for img_b64 in image_b64_list:
            if mode == "plain":
                path = _save_image(img_b64, out_dir, next_idx)
                _resize_proportional(path)
                print(path)
                saved_paths.append(path)
            else:
                greenscreen_path = _save_image(img_b64, out_dir, next_idx, suffix="-greenscreen")
                _resize_proportional(greenscreen_path)
                print(greenscreen_path)
                saved_paths.append(greenscreen_path)
                if mode == "transparent":
                    transparent_path = greenscreen_path.with_name(
                        greenscreen_path.name.replace("-greenscreen", "-transparent")
                    )
                    shutil.copy2(greenscreen_path, transparent_path)
                    _chroma_key_green(transparent_path)
                    print(transparent_path)
                    saved_paths.append(transparent_path)
            next_idx += 1

    return saved_paths


def _transparent_output_path(path: Path) -> Path:
    if "-greenscreen" in path.name:
        return path.with_name(path.name.replace("-greenscreen", "-transparent"))
    return path.with_name(f"{path.stem}-transparent{path.suffix}")


def run_key_only(image_path: Path) -> Path:
    """Create a keyed transparent output from a greenscreen source image."""
    if not image_path.is_file():
        raise FileNotFoundError(f"Image not found: {image_path}")
    out_path = _transparent_output_path(image_path)
    shutil.copy2(image_path, out_path)
    _chroma_key_green(out_path)
    print(out_path)
    return out_path


# ── CLI ─────────────────────────────────────────────────────────────────────

def main() -> int:
    parser = argparse.ArgumentParser(
        description="Generate images with OpenAI (Responses API).",
    )
    parser.add_argument(
        "prompt",
        nargs="?",
        help="Text description. Reference images as 'Image 1', 'Image 2', etc.",
    )
    parser.add_argument(
        "-d", "--output-dir", required=True, type=Path,
        help="Base output directory.",
    )
    parser.add_argument(
        "-n", "--num-images", type=int, default=3, metavar="N",
        help="Number of candidates (default: 3).",
    )
    parser.add_argument(
        "-m", "--model", default=DEFAULT_MODEL,
        help=f"Model id (default: {DEFAULT_MODEL}).",
    )
    parser.add_argument(
        "-i", "--reference-image", action="append", type=Path,
        default=None, dest="reference_images", metavar="FILE",
        help="Reference image (repeat for multiple).",
    )
    parser.add_argument(
        "-s", "--subdir", default=None, metavar="NAME",
        help="Subdirectory name (e.g. 'potato-agent-hero').",
    )
    parser.add_argument(
        "-q", "--quality", default=DEFAULT_QUALITY,
        choices=["low", "medium", "high"],
        help=f"Image quality (default: {DEFAULT_QUALITY}).",
    )
    parser.add_argument(
        "--size", default=DEFAULT_SIZE,
        help=f"Image dimensions (default: {DEFAULT_SIZE}).",
    )
    parser.add_argument(
        "-t", "--transparent", action="store_true",
        help="Generate greenscreen and keyed transparent outputs.",
    )
    parser.add_argument(
        "--greenscreen-only", action="store_true",
        help="Generate and save only the greenscreen render.",
    )
    parser.add_argument(
        "--key-only", type=Path,
        help="Skip generation and create a transparent output from an existing greenscreen image.",
    )
    args = parser.parse_args()

    if args.key_only and args.prompt:
        print("Do not provide a prompt with --key-only.", file=sys.stderr)
        return 2
    if not args.key_only and not args.prompt:
        print("Prompt is required unless using --key-only.", file=sys.stderr)
        return 2
    if args.num_images < 1:
        print("--num-images must be at least 1", file=sys.stderr)
        return 2
    if args.greenscreen_only and args.transparent:
        print("Use either --greenscreen-only or --transparent, not both.", file=sys.stderr)
        return 2

    refs: list[Path] = args.reference_images or []
    for ref in refs:
        if not ref.is_file():
            print(f"Reference image not found: {ref}", file=sys.stderr)
            return 2

    if args.key_only:
        try:
            out_path = run_key_only(args.key_only.expanduser().resolve())
            print(f"\nSaved 1 image to {out_path.parent}/", file=sys.stderr)
        except Exception as e:
            print(e, file=sys.stderr)
            return 1
        return 0

    api_key = os.environ.get("OPENAI_API_KEY")
    if not api_key:
        print("Set OPENAI_API_KEY in the environment.", file=sys.stderr)
        return 2

    model = args.model.strip()
    base_dir = args.output_dir.expanduser().resolve()
    slug = args.subdir.strip() if args.subdir else _prompt_slug(args.prompt)
    out_dir = base_dir / slug
    out_dir.mkdir(parents=True, exist_ok=True)

    try:
        from openai import OpenAI
    except ImportError:
        print("Install openai.", file=sys.stderr)
        return 2

    client = OpenAI(api_key=api_key)

    mode = "plain"
    if args.greenscreen_only:
        mode = "greenscreen"
    elif args.transparent:
        mode = "transparent"

    prompt = args.prompt
    if mode in {"greenscreen", "transparent"}:
        prompt = (
            "The background of the image must be a perfectly flat solid bright green screen — "
            "exactly hex color #00FF00, like a chroma key green screen used in video production. "
            "Fill the entire background with this exact solid #00FF00 green. "
            "Do not use gradients, vignettes, floor shadows, background shading, ambient glow, reflections, texture, checkered patterns, or any other background treatment. "
            "The background must be completely uniform and flat because it will be removed later. " + prompt
        )

    try:
        paths = run_generate(
            client, model, prompt, out_dir,
            args.num_images, refs, mode=mode,
        )
        print(f"\nSaved {len(paths)} image(s) to {out_dir}/", file=sys.stderr)
    except Exception as e:
        print(e, file=sys.stderr)
        return 1

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
