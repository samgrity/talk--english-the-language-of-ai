# Model used by AI screening agent + LinkedIn username lookup agent.
AI_MODEL=anthropic:claude-sonnet-4-6

# Required for Anthropic-backed models.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Required for LinkedIn profile fetch via linkdapi.
LINKEDAPI_API_KEY=your_linkdapi_api_key_here

# Optional frontend override for backend API URL.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
